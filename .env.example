# Open Prod — API générique (Odoo-like) : POST /web/api/getToken puis /web/api/endpoint
# URL HTTPS de l'instance (serveur interne misrv-opp1, joignable depuis le réseau Matfer ou le VPN Kerio)
OPEN_PROD_BASE_URL=https://misrv-opp1.matferbourgeat.com
# Nom de la base Open Prod (paramètre "db" de l'API)
OPEN_PROD_DB=
# Clé API de ton utilisateur Open Prod (avatar > Mes préférences > Sécurité du compte > Nouvelle clé API)
OPEN_PROD_API_KEY=your_id_secret_here
# Certificat du serveur interne non reconnu : false pour ne pas le vérifier
OPEN_PROD_VERIFY_TLS=false
# Mapping contrôle Keck3 → modèle/champs Open Prod (copier openprod_mapping.example.json → data/openprod_mapping.json)
#OPEN_PROD_MAPPING_FILE=data/openprod_mapping.json

# Port série du banc D1118 — 'auto' = adaptateur reconnu par SERIAL_PORT_MATCH, sinon l'unique port présent
# Sinon fixer : COM3, COM4 (Windows) ou /dev/ttyUSB0 (Linux/Mac)
SERIAL_PORT=auto
# Expression (insensible à la casse) reconnaissant l'adaptateur série du banc dans la description/hwid du port
SERIAL_PORT_MATCH=USB|FTDI|Prolific|CH340|CP210|UART
SERIAL_BAUDRATE=9600

# Impression des étiquettes (Windows uniquement) — lister les imprimantes : python printer_test.py
LABEL_PRINTER_BARCODE=\\misrv-imp\MI-IMPCB-M1-01
LABEL_PRINTER_SERIAL=\\misrv-imp\MI-IMPCB-M1-02
PRINT_LABELS=true
# Comportement keck1 : pas d'étiquette si l'envoi à Open Prod a échoué
PRINT_REQUIRES_API_SUCCESS=true

# Référentiel des programmes (copier programs.example.json → data/programs.json)
#PROGRAMS_FILE=data/programs.json

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/keck3.log

# Interface web
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=5000
