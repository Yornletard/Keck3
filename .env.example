# Configuration Open Prod
OPEN_PROD_BASE_URL=https://open-prod.matferbourgeat.com
OPEN_PROD_API_KEY=your_api_key_here

# Configuration Port Série
# Linux/Mac: /dev/ttyUSB0, /dev/ttyACM0, etc.
# Windows: COM3, COM4, etc.
SERIAL_PORT=COM3
SERIAL_BAUDRATE=9600

# Configuration Impression Étiquettes (Windows uniquement - impression immédiate)
# Pour trouver les noms d'imprimantes: python -c "from core.label_printer import LabelPrinter; LabelPrinter().list_network_printers()"
LABEL_PRINTER_BARCODE=\\misrv-imp\MI-IMPCB-M1-01
LABEL_PRINTER_SERIAL=\\misrv-imp\MI-IMPCB-M1-02

# Configuration Logging
LOG_LEVEL=INFO
LOG_FILE=logs/keck3.log
